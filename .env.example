# Copy this file to ".env" and fill in your Alpaca PAPER keys.
# Get them at https://app.alpaca.markets (switch to the Paper account, then "API Keys").
# Never commit .env and never paste these keys into a chat.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading only. Live trading is locked in the code until the go-live checks pass.
ALPACA_PAPER=true

# Plan settings
STARTING_CAPITAL=50
KILL_SWITCH_DRAWDOWN=0.20

# Optional: comma-separated symbols to track (default: SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA,IWM)
WATCHLIST=

# Optional
DB_PATH=data/agent.db
SNAPSHOT_INTERVAL_MINUTES=15
SNAPSHOT_MAX_DAYS_TO_EXPIRY=60
SNAPSHOT_STRIKE_BAND=0.15

# Stan's API (the phone app reads from it). Set a token if you are on shared Wi-Fi.
STAN_API_TOKEN=
STAN_API_PORT=8000

# Stan on Discord (see the README section "Talk to Stan on Discord").
# Never commit these or paste them into a chat.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_CHANNEL_ID=
# Optional: Stan's local brain in Ollama (free, runs on this PC's GPU)
# STAN_MODEL=qwen3:14b
# OLLAMA_URL=http://127.0.0.1:11434
# STAN_THINK=false
